[Unit]
Description=Trade Swing Bot weekly mapped-underlying strength review
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/tradebot/Trade-Swing-Bot/main
ExecStart=/home/tradebot/Trade-Swing-Bot/main/.venv/bin/python -m swing_trade_bot.weekly_mapped_universe_review
User=root

[Install]
WantedBy=multi-user.target
