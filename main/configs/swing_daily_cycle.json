{
  "cycle_schema_version": "1.0",
  "plugin_id": "SWING-001",
  "paper_trade_mode": true,
  "advisory_only": true,
  "automatic_activation_allowed": false,
  "broker_execution_allowed": false,
  "capital_movement_allowed": false,
  "direct_database_writes": false,
  "publish_registration_last": true,
  "atomic_publish_required": true,
  "static_artifacts": {
    "swing_plugin_manifest.json": "configs/swing_cio_plugin_manifest.json",
    "swing_output_contract.json": "configs/swing_cio_output_contract.json",
    "swing_schema_registry.json": "configs/swing_cio_schema_registry.json",
    "swing_strategy_service_registration.json": "configs/swing_strategy_service_registration.json",
    "swing_strategy_capability_profiles.json": "configs/swing_strategy_capability_profiles.json",
    "swing_committee_governance.json": "configs/swing_committee_governance.json"
  },
  "runtime_evidence_refresh": {
    "enabled": true,
    "watchlist": {
      "candidates_path": "results/discovery_candidates_runtime.csv",
      "mentions_path": "results/discovery_mentions_runtime.csv",
      "financial_health_path": "results/discovery_financial_health_runtime.csv"
    },
    "portfolio_allocation": {
      "confidence_path": "results/confidence_report.csv",
      "strategy_recommendations_path": "results/strategy_recommendations.csv"
    },
    "paper_ledger": {
      "ledger_dir": "results/paper_ledger",
      "data_dir": "data",
      "max_price_age_days": 5
    }
  },
  "validation_config": "configs/swing_cio_validation_suite.json",
  "acceptance_config": "configs/swing_cio_acceptance_test.json",
  "freeze_config": "configs/swing_cio_milestone_1_freeze.json",
  "local_integration_config": "configs/swing_local_filesystem_integration.json",
  "decision_trace_evidence_path": "results/swing_committee_runtime_evidence.json",
  "decision_trace_path": "results/swing_committee_decision_trace.json",
  "opportunity_quality_input_path": "results/opportunity_quality_inputs.json",
  "required_strategy_reports": [
    "results/opportunity_quality_report.json",
    "results/stock_performance_report.json",
    "results/weekly_stock_report.json",
    "results/executive_dashboard.json",
    "results/monthly_command_center.json"
  ],
  "cycle_report_json": "results/swing_daily_cycle_report.json",
  "cycle_report_markdown": "results/swing_daily_cycle_report.md"
