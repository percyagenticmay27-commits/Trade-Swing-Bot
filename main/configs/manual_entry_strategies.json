{
  "schema_version": "1.1",
  "paper_trade_mode": true,
  "allocation_authority": "SWING_PORTFOLIO_ALLOCATOR",
  "default_strategy_id": "SWING_DAILY_TREND_V1",
  "strategies": [
    {
      "strategy_id": "SWING_DAILY_TREND_V1",
      "name": "Swing Daily Trend Entry",
      "timeframe": "1D",
      "rule_logic": "ALL",
      "number_of_entries": 1,
      "enabled": true,
      "description": "Current daily WATCHLIST entry gate expressed as user-editable declarative rules. Swing owns total dollar allocation; number_of_entries only controls equal staged slices.",
      "paper_trade_mode": true,
      "rules": [
        {
          "left": "close",
          "operator": ">",
          "right": "ema",
          "period": 20,
          "label": "Close above EMA(20)"
        },
        {
          "left": "close",
          "operator": ">",
          "right": "sma",
          "period": 50,
          "label": "Close above SMA(50)"
        },
        {
          "left": "rsi",
          "operator": "between",
          "right": [45.0, 65.0],
          "period": 14,
          "label": "RSI(14) between 45 and 65"
        },
        {
          "left": "volume",
          "operator": ">",
          "right": "volume_average",
          "period": 20,
          "label": "Volume above prior 20-day average"
        },
        {
          "left": "market_filter",
          "operator": "==",
          "right": 1.0,
          "label": "Market filter satisfied"
        }
      ]
    }
  ],
  "assignments": []
}
